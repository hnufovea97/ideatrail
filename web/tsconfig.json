{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "strict": true, "resolveJsonModule": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"], "types": ["node"],
    "jsx": "react-jsx", "jsxImportSource": "preact"
  },
  "include": ["src", "scripts", "e2e", "playwright.config.ts", "vitest.config.ts"],
  "exclude": ["dist", ".e2e", "node_modules"]
}
