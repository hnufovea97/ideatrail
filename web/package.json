{
  "name": "web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "devEngines": { "packageManager": { "name": "pnpm", "version": "12.18.0", "onFail": "download" } },
  "scripts": {
    "dev": "astro dev --port 4321 --host localhost",
    "build": "astro build && node scripts/csp.ts",
    "preview": "astro preview --port 4321 --host localhost",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/preact": "6.1.1",
    "@ideatrail/crypto": "workspace:*",
    "astro": "7.4.5",
    "preact": "11.1.1",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
